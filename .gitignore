node_modules
dist
test-results
playwright-report
*.tsbuildinfo
.DS_Store
.next
out
coverage
.turbo
*.log
.env*
!.env.example
blob-report

dist-ssr

.svelte-kit*

# Files the docs walkthrough tests extract from the docs.
packages/*/test/.walkthrough/
.vercel

# The docs as Markdown each package ships, written by scripts/package-docs.mjs at release.
packages/*/docs/
# The root LICENSE each package ships, copied in by its prepack script.
packages/*/LICENSE
# The web components' elements manifest and VS Code data, written with them.
packages/web/custom-elements.json
packages/web/html-custom-data.json

# The web components built for pages without a bundler, written by their build.
packages/web/browser/
# The @ui-sdk/web releases apps/docs/scripts/web-releases.mjs copies in before a build.
apps/docs/public/web@*
# The compiled examples, written by examples/vite.config.ts.
apps/docs/public/examples/
# Git worktrees agents work in, inside the workspace.
.claude/worktrees/

# DeepSec scan workspace and results.
.deepsec/

# The Nuxt dev test installs packed copies of the packages (tests/nuxt-dev/prepare.mjs).
tests/nuxt-dev/.vendor/
tests/nuxt-dev/app/.nuxt/
